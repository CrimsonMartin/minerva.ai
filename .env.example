# Copy to `.env` to override the LLM connection (defaults live in
# minerva/config.py). Real environment variables win over this file.
#
# Chat: any OpenAI-compatible endpoint — LM Studio, llama.cpp, vLLM, Ollama.
MINERVA_LLM_BASE_URL=http://localhost:1234/v1
MINERVA_LLM_API_KEY=lm-studio
MINERVA_LLM_CHAT_MODEL=qwen/qwen3-14b

# Embeddings run in-process by default (no server needed). To use an
# OpenAI-compatible embeddings endpoint instead, uncomment:
#MINERVA_LLM_EMBED_MODEL=text-embedding-nomic-embed-text-v1.5
#MINERVA_LLM_EMBED_BASE_URL=http://localhost:1234/v1

# NCBI asks that E-utilities requests identify a contact address.
MINERVA_PUBMED_EMAIL=you@example.com
